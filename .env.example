# SYNAPSE — local persistent config.
#
# Copy this file to `.env` (which is GITIGNORED) and fill the values. The loader uses Node 22's NATIVE
# parser (no dotenv, no extra dependency) and is applied at the Doctor/Preflight/CLI entry points.
#
#   cp .env.example .env     # Linux/macOS
#   copy .env.example .env   # Windows (cmd)
#
# Rules:
#   - Variables ALREADY set in the environment take PRECEDENCE (the .env never overrides them).
#   - Values are NEVER printed in logs, Doctor output or reports — only variable NAMES are shown.
#   - The mere presence of this file does NOT authorize any operation; authorization stays in the
#     operator-provided Execution Context and the policies.
#   - This file is CENTRAL, so it does not reach every project. Only known plain config (e.g. CAIDO_BASE_URL,
#     SA_ENGAGEMENT_ROOT) applies everywhere; unknown keys are withheld. CAIDO_TOKEN loads only for the commands that need it,
#     at the harness root or in a project activated with --caido, a decision kept beside this file (.env.caido-opt-ins.json),
#     by real path, not in the project. SA_ENGAGEMENT, SA_SESSION_ID and CAIDO_PROJECT_ID from this
#     file apply only at the harness root. Exported variables always apply. Least privilege, NOT a barrier: an agent with a
#     shell can read this file, so real separation needs OS-level isolation.
#   - Keep secrets out of the repo: `.env` and its local variants are gitignored.

# =====================================================================================================
# CAIDO INSTANCE config (per INSTANCE — shared across all engagements on this machine)
# =====================================================================================================
CAIDO_BASE_URL=https://your-lab-caido:port
CAIDO_TOKEN=replace-with-your-personal-access-token

# =====================================================================================================
# ENGAGEMENT selection (multi-engagement: one workspace + one Caido project per pentest)
# =====================================================================================================
# Base directory for ALL engagements — OUTSIDE this repo (the harness is NOT duplicated per engagement).
SA_ENGAGEMENT_ROOT=/path/to/engagements
#
# The ACTIVE engagement is selected DYNAMICALLY per session — no .env edit needed to switch:
#   node tools/workspace/cli.mjs list                 # see engagements
#   node tools/workspace/cli.mjs use --name <name>    # select the active one for this session
#   node tools/workspace/cli.mjs active               # show the current selection
# Create/associate via: cli.mjs init | scope | associate.
#
# SA_ENGAGEMENT below is an OPTIONAL selector for automation. It selects on its own only in a plain directory or at the
# harness root; in an activated project it must match the selection or commands refuse. Leave it unset for normal interactive use.
# SA_ENGAGEMENT=my-engagement
#
# SA_SESSION_ID (optional): isolates the active-engagement pointer between concurrent sessions on one root.
# Unset in an activated project, a stable per-project session is derived from its activation marker. Set, it stays bound
# to the project: the same value in another project sees no selection. Outside a project, it is the only way to select.
# SA_SESSION_ID=
#
# SA_SKIP_ENV_FILE (optional): when set to 1, the CLIs do NOT auto-load this .env; the provided process
# environment wins entirely. For hermetic automation/tests (e.g. tools/workspace/test-skills.mjs). NOT for
# normal operation. SA_SKIP_ENV_FILE=

# --- Caido PROJECT binding ---
# The Caido project is bound PER ENGAGEMENT (stored in <engagement>/.engagement.json via
# `cli.mjs associate --project-id <id>`). It is derived from the SELECTED engagement — there is NO
# mandatory global project id in the multi-engagement flow.
#
# CAIDO_PROJECT_ID below is an OPTIONAL single-engagement COMPAT fallback ONLY. It is used solely when
# the active engagement has no bound project, it NEVER overrides an engagement's binding, and it never
# causes a silent switch to another project. Prefer `cli.mjs associate`.
# CAIDO_PROJECT_ID=your-authorized-project-id

# =====================================================================================================
# Evidence (per-engagement — no global config)
# =====================================================================================================
# Persistent AUDIT evidence (screenshots, captures, records) is stored in the ACTIVE engagement at
# <engagement>/evidence — resolved automatically from the selected engagement. There is NO global evidence
# directory and NO /tmp fallback: with no active engagement, evidence-persisting operations fail explicitly.
# (Transient scratch/work files may still use the OS temp dir; those are NOT audit evidence.)
#
# SA_EVIDENCE_DIR is DEPRECATED as an operational default. It is honored ONLY as a legacy fallback when NO
# engagement is active, and it NEVER overrides the active engagement's evidence dir. Leave it unset.
# SA_EVIDENCE_DIR=
